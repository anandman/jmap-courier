{
  "name": "jmap-courier",
  "version": "1.0.0",
  "description": "TypeScript JMAP client for email (RFC 8620/8621) - works with any JMAP provider",
  "keywords": [
    "contacts",
    "cyrus",
    "email",
    "fastmail",
    "imap",
    "jmap",
    "mail",
    "rfc8620",
    "rfc8621",
    "stalwart"
  ],
  "license": "MIT",
  "author": "Anand Mandapati",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/anandman/courier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anandman/jmap-courier.git"
  },
  "bugs": {
    "url": "https://github.com/anandman/jmap-courier/issues"
  },
  "files": [
    "dist"
  ]
}
